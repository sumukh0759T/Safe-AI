[Unit]
Description=SafeBath AI static dashboard (port 8080)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vinnu
Group=vinnu
WorkingDirectory=/home/vinnu/Safe-AI/safebath-ai/frontend
ExecStart=/usr/bin/python3 /home/vinnu/Safe-AI/safebath-ai/frontend/serve_static.py --bind 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/vinnu/Safe-AI/safebath-ai/frontend

[Install]
WantedBy=multi-user.target

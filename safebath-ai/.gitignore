__pycache__/
*.pyc
.pytest_cache/
.venv/

# data — everything under data/ is regenerable or private runtime state
data/raw/*
data/synthetic/*
data/real/*
data/*.db

# trained artifacts
models/*.h5
models/*.tflite
models/*.pkl
models/*.json

# env
.env

# deployment — runtime artifacts created by install.sh if a custom
# SAFEBATH_ETC_DIR/INSTALL_DIR is pointed inside the repo (never commit these)
deployment/raspberry_pi/*.env
deployment/raspberry_pi/install.conf

# node
frontend/node_modules/
frontend/dist/

# per-machine API override — see frontend/config.example.js
frontend/config.local.js

# keep directory structure
!**/.gitkeep

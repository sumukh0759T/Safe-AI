# SafeBath AI runtime configuration (copy to .env or set in the environment).
# The Pi runs fully offline without any of the cloud values below.

# --- Local edge server ---
SQLITE_PATH=data/events.db
API_PORT=8000

# --- Device registry / simulation (dashboard truthfulness) ---
# Optional JSON file mapping device_id -> {module,name,token}. If unset, the
# built-in registry in the DB is used.
# SAFEBATH_DEVICES=/etc/safebath/devices.json
# Comma-separated device_ids the dashboard should clearly label as SIMULATED
# (mock publisher data), never as live hardware.
# SAFEBATH_SIMULATED_DEVICES=mat-01,radar-01,toilet-01,audio-01,tof-01

# --- Local alarm output (fires immediately, never waits for cloud) ---
# A command launched as: <SAFEBATH_LOCAL_ALARM> <event_id> <trigger>
# e.g. a GPIO/buzzer/siren script. Leave empty to only log the alarm.
# SAFEBATH_LOCAL_ALARM=/usr/local/bin/safebath_alarm.sh

# --- Supabase cloud mirror (optional; local safety works without it) ---
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Web push (VAPID) for caretaker notifications (optional) ---
# Generate once with: python -m backend.push_service --generate-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# PUSH_SUBJECT=mailto:caretaker@example.com
